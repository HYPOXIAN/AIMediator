__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.env
.env.*
!.env.example
.DS_Store
*.log
*.tmp
*.bak
*~

# Keep local datasets and generated reports out of version control by default.
data/raw/*
!data/raw/.gitkeep
!data/raw/debug/
data/processed/*
!data/processed/.gitkeep
# reports/ (RULES.md P2): only manifests and curated summaries are tracked.
reports/**
!reports/*/
!reports/*/manifest.json
!reports/*/summary/
!reports/*/summary/**

# Run output (RULES.md P2); safe to empty.
runs/
