__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.env
.env.*
!.env.example
.DS_Store
*.log
*.tmp
*.bak
*~

# Keep local datasets and generated reports out of version control by default.
# Dataset manifests are tracked (RULES.md P1; batch 3 decision P3-D05).
data/raw/**
!data/raw/.gitkeep
!data/raw/debug/
!data/raw/debug/**
!data/raw/*/
!data/raw/*/*/
!data/raw/*/*/manifest.json
data/processed/**
!data/processed/.gitkeep
!data/processed/*/
!data/processed/*/manifest.json
# reports/ (RULES.md P2): only manifests and curated summaries are tracked.
reports/**
!reports/*/
!reports/*/manifest.json
!reports/*/summary/
!reports/*/summary/**

# Run output (RULES.md P2); safe to empty.
runs/
