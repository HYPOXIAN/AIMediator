#!/bin/sh
# Report-only pre-commit hook (docs/plans/reorganization.md, section 2).
# Prints RULES.md violations and never blocks the commit; batch 4 switches
# it to blocking once the violation count reaches zero.
# Enable with: git config core.hooksPath scripts/maintenance/hooks
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
echo "pre-commit: rule check (report only, does not block)"
python3 "$root/scripts/maintenance/check_rules.py" --root "$root" || true
exit 0
