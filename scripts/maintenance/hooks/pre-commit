#!/bin/sh
# Blocking pre-commit hook (reorganization plan, section 2; RULES.md G10).
# Runs the rule check and refuses the commit when it reports a violation.
# Enable with: git config core.hooksPath scripts/maintenance/hooks
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
echo "pre-commit: rule check (blocking)"
if ! python3 "$root/scripts/maintenance/check_rules.py" --root "$root"; then
    echo "pre-commit: commit refused; fix the violations listed above (RULES.md)." >&2
    exit 1
fi
exit 0
